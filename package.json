{
  "name": "@matbour/setup-sentry-cli",
  "version": "3.0.0",
  "description": "Install the Sentry CLI in your GitHub Actions workflow.",
  "keywords": [
    "github-actions",
    "actions",
    "sentry",
    "sentry-cli",
    "sentry-release"
  ],
  "homepage": "https://github.com/matbour/setup-sentry-cli",
  "bugs": "https://github.com/matbour/setup-sentry-cli/issues",
  "license": "MIT",
  "main": "dist/main.js",
  "author": "Mathieu Bour <mat@bour.io>",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "bun run build.ts",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ]
}
